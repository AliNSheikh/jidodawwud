# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GITHUB_PAT: GitHub Personal Access Token (with repo scope contents:read, contents:write)
# If provided, all menu saves automatically create commits directly in your GitHub repo!
GITHUB_PAT=""

# GITHUB_REPO_OWNER: GitHub user or organization name (e.g. "octocat")
GITHUB_REPO_OWNER=""

# GITHUB_REPO_NAME: GitHub repository name (e.g. "luxury-restaurant-menu")
GITHUB_REPO_NAME=""

# GITHUB_BRANCH: Target branch to sync with (defaults to "main")
GITHUB_BRANCH="main"

# GITHUB_FILE_PATH: Target file in repo (defaults to "data/menu.json")
GITHUB_FILE_PATH="data/menu.json"

# ADMIN_SECRET_KEY: Master password or secret key for admin authentication (default fallback: "etoile2026")
ADMIN_SECRET_KEY="etoile2026"
